    "packetVersion": "v2",
    "queueDepth": 64,
    "endpoints": {
      "fibonacci-client": {
        "role": "client",
        "remote": {
          "address": "127.0.0.1",
          "port": 54011
        }
      },
      "fibonacci-server": {
        "role": "server",
        "local": {
          "address": "0.0.0.0",
          "port": 54011
        }
      }
    }
  }
}
